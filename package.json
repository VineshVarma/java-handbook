{
  "name": "java-handbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -p 3000",
    "lint": "next lint",
    "test:diagrams": "node scripts/audit-diagram-states.mjs",
    "test:snippets": "node scripts/extract-snippets.mjs && node scripts/compile-snippets.mjs",
    "test:objectives": "node scripts/audit-objectives.mjs",
    "test:copy": "node scripts/lint-copy.mjs",
    "test:facts": "node scripts/audit-facts.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:diagrams && npm run test:snippets && npm run test:objectives && npm run test:copy && npm run test:facts",
    "audit": "npm run test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "next": "^14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
